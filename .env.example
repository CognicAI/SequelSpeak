# SequelSpeak Docker Environment Configuration Template
# Copy this file to .env and fill in your values
# Usage: docker-compose --env-file .env up

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=production
APP_NAME=SequelSpeak Backend
BUILD_DATE=unknown

# ==========================================
# Security Settings
# ==========================================
# REQUIRED: Generate a secure secret key (minimum 32 characters)
# Example: openssl rand -hex 32
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-MIN-32-CHARS

# REQUIRED: Clerk authentication keys
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# CORS origins (comma-separated list)
# For production, specify exact origins (no wildcard)
# Include http://localhost when using Docker frontend on port 80.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://yourdomain.com

# ==========================================
# Database Connection Settings
# ==========================================
DB_CONNECTION_TIMEOUT=10
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=30

# Optional: Default database for health checks
# Format: postgresql://username:password@host:port/database
# Example: postgresql://myuser:mypass@db.example.com:5432/mydb
HEALTH_CHECK_DB_URL=

# ==========================================
# Health Check Settings
# ==========================================
HEALTH_CHECK_TIMEOUT=2
HEALTH_CHECK_RETRY_MAX=1

# ==========================================
# Retry Settings
# ==========================================
CONNECTION_RETRY_MAX=2
CONNECTION_RETRY_INITIAL_DELAY=1.0

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=3

# ==========================================
# Circuit Breaker
# ==========================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# ==========================================
# Redis Settings (for ConversationState)
# ==========================================
# Managed by docker-compose, no changes needed
# REDIS_URL=redis://redis:6379/0

# ==========================================
# Frontend Settings
# ==========================================
# REQUIRED: Frontend API URL (where the frontend should connect to the backend)
# This is used by Vite at build time to set the API endpoint
# Examples:
#   - Local development: http://localhost:8000
#   - Server deployment: http://YOUR_SERVER_IP:8000
# Change this to your server's IP address when deploying
VITE_API_URL=http://localhost:8000

# REQUIRED: Frontend Clerk publishable key (injected at frontend build time)
# Usually the same value as CLERK_PUBLISHABLE_KEY above
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
