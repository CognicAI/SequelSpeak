# =============================================================================
# SequelSpeak Backend - Environment Configuration
# =============================================================================
# Copy this file to `.env` and customize values as needed.
# DO NOT commit the `.env` file to version control - it may contain secrets.
#
# Legend:
#   [REQUIRED]  - Must be set (enforced in production)
#   [OPTIONAL]  - Has a default value
#   [DEV-ONLY]  - Only for development environment
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Application name (displayed in logs and API responses)
# [OPTIONAL] Default: "SequelSpeak Backend"
APP_NAME=SequelSpeak Backend

# Runtime environment: development | staging | production
# [REQUIRED] No default - must be explicitly set
# - development: Relaxed validation, debug features enabled, wildcard CORS allowed
# - staging: Production-like with some debug features
# - production: Strict validation, all security features enforced, explicit CORS required
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------

# Secret key for sessions, JWT tokens, and cryptographic operations
# [REQUIRED in production] Optional in development
# SECURITY: Must be at least 32 characters, use cryptographically random string
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit this value to version control!
SECRET_KEY=

# Allowed CORS origins (comma-separated)
# [REQUIRED] No default - must be explicitly set
# ⚠️ SECURITY: Wildcard (*) is ONLY allowed in development/staging
# ⚠️ PRODUCTION: Must specify explicit origins with http:// or https:// prefix
# Examples:
#   - Development: * (wildcard - for testing only)
#   - Production: https://app.example.com,https://admin.example.com
# Validation:
#   - Production environment blocks wildcard (*)
#   - All origins must start with http:// or https://
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------

# PostgreSQL connection timeout in seconds
# [OPTIONAL] Default: 10
# - Increase for slow networks or remote databases
# - Decrease to fail faster on connection issues
# - Maximum recommended: 60 seconds
DB_CONNECTION_TIMEOUT=10

# -----------------------------------------------------------------------------
# Connection Pool Settings
# -----------------------------------------------------------------------------

# Minimum number of connections maintained in the pool
# [OPTIONAL] Default: 1
# - Set to 0 to create connections on-demand
# - Higher values reduce connection latency but consume more resources
DB_POOL_MIN_SIZE=1

# Maximum number of connections allowed in the pool
# [OPTIONAL] Default: 5
# - Prevents PostgreSQL max_connections exhaustion
# - Set based on expected concurrent users and database capacity
# - Recommended: Keep under PostgreSQL max_connections / number_of_app_instances
DB_POOL_MAX_SIZE=5

# Pool connection acquisition timeout in seconds
# [OPTIONAL] Default: 30
# - Time to wait for an available connection from the pool
# - Lower values fail faster when pool is exhausted
# - Higher values are more tolerant of temporary load spikes
DB_POOL_TIMEOUT=30

# Maximum idle time for pooled connections in seconds
# [OPTIONAL] Default: None (no max idle time)
# - Automatically closes connections idle longer than this duration
# - Helps prevent "connection closed by server" errors
# - Set to slightly less than PostgreSQL's idle_in_transaction_session_timeout
# DB_POOL_MAX_IDLE=600

# -----------------------------------------------------------------------------
# Health Check Settings
# -----------------------------------------------------------------------------

# Database URL for health check endpoint
# [OPTIONAL] If not set, health endpoint returns "unknown" database status
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@localhost:5432/mydb

# -----------------------------------------------------------------------------
# Authentication Settings (Clerk)
# -----------------------------------------------------------------------------

# Clerk Secret Key for JWT verification
# [REQUIRED for authentication] If not set, endpoints requiring auth will fail
# Get from: Clerk Dashboard > API Keys > Secret Keys
# Format: sk_live_... (production) or sk_test_... (development/staging)
# SECURITY: NEVER commit this value to version control!
# This key is used to verify JWT tokens from the frontend
CLERK_SECRET_KEY=

# Clerk Publishable Key (for reference and JWKS endpoint discovery)
# [OPTIONAL] Used for debugging and constructing JWKS URLs
# Get from: Clerk Dashboard > API Keys > Publishable Keys
# Format: pk_live_... (production) or pk_test_... (development/staging)
# This is safe to expose client-side (already in frontend .env)
CLERK_PUBLISHABLE_KEY=
# SECURITY: This should use a read-only user with minimal permissions
HEALTH_CHECK_DB_URL=

# Health check timeout in seconds (keep low for fast response)
# [OPTIONAL] Default: 2
# - Lower values provide faster health check responses
# - Higher values are more tolerant of slow database responses
HEALTH_CHECK_TIMEOUT=2

# -----------------------------------------------------------------------------
# Connection Retry Settings
# -----------------------------------------------------------------------------

# Maximum number of retry attempts for user connection tests
# [OPTIONAL] Default: 2
# - Retries only occur on transient CONNECTION_LOST errors
# - Does not retry on auth failures, SSL errors, or timeouts
# - Higher values increase resilience but delay failure feedback
# - Total attempts = 1 initial + CONNECTION_RETRY_MAX retries
CONNECTION_RETRY_MAX=2

# Initial delay before first retry in seconds (uses exponential backoff)
# [OPTIONAL] Default: 1.0
# - First retry waits this duration
# - Second retry waits 2x this duration
# - Third retry waits 4x this duration, etc.
# - Lower values provide faster recovery but may hit rate limits
CONNECTION_RETRY_INITIAL_DELAY=1.0

# Maximum number of retry attempts for health checks
# [OPTIONAL] Default: 1
# - Keep low (1-2) to maintain fast health check response times
# - No backoff delay (immediate retry) to detect quick recoveries
# - Higher values may cause health check timeouts
HEALTH_CHECK_RETRY_MAX=1

# -----------------------------------------------------------------------------
# Rate Limiting Settings (DoS Protection)
# -----------------------------------------------------------------------------

# Enable rate limiting for API endpoints
# [OPTIONAL] Default: True
# - Protects against abuse and DoS attacks
# - Set to False to disable (not recommended for production)
# - Test environments may set to False to avoid interference
RATE_LIMIT_ENABLED=True

# Maximum requests per minute per IP for test-connection endpoint
# [OPTIONAL] Default: 10
# - Prevents malicious users from overwhelming the database
# - Adjust based on legitimate usage patterns
# - Lower values provide better protection but may limit legitimate users
# - Higher values are more permissive but less protective
RATE_LIMIT_PER_MINUTE=10

# Allow short bursts of this many requests
# [OPTIONAL] Default: 3
# - Permits brief spikes in traffic without triggering rate limit
# - Set to 1 to enforce strict per-minute limit
# - Higher values allow more flexibility for legitimate burst usage
RATE_LIMIT_BURST=3

# -----------------------------------------------------------------------------
# Circuit Breaker Settings (Database Protection)
# -----------------------------------------------------------------------------

# Enable circuit breaker for database connections
# [OPTIONAL] Default: True
# - Prevents cascade failures when database is down
# - Stops requests from overwhelming a struggling database
# - Set to False to disable (not recommended for production)
CIRCUIT_BREAKER_ENABLED=True

# Number of consecutive failures before opening circuit
# [OPTIONAL] Default: 5
# - Lower values open circuit faster (more aggressive)
# - Higher values tolerate more failures before breaking
# - Recommended: 3-10 depending on tolerance for database instability
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before trying again after circuit opens
# [OPTIONAL] Default: 60
# - Cooldown period before attempting recovery
# - Lower values retry sooner (may overwhelm recovering database)
# - Higher values give database more time to stabilize
# - Recommended: 30-300 seconds depending on recovery time expectations
CIRCUIT_BREAKER_TIMEOUT=60

# -----------------------------------------------------------------------------
# Development / Debug Settings
# -----------------------------------------------------------------------------

# [DEV-ONLY] Enable debug mode with verbose logging
# Uncomment only in development
# DEBUG=true
